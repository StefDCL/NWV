---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import galerij from '../../data/galerij.json';

type Album = (typeof galerij)[number];
export function getStaticPaths() {
  const sorted = [...galerij].sort((a, b) => b.title.localeCompare(a.title));
  return sorted.map((album, i) => ({ params: { album: album.slug }, props: { album, nieuwer: sorted[i - 1], ouder: sorted[i + 1] } }));
}
interface Props { album: Album; nieuwer?: Album; ouder?: Album }
const { album, nieuwer, ouder } = Astro.props;
---
<Base title={album.title} description={`Fotoalbum ${album.title} van de Nievdonckse Watersport Vereniging.`} image={album.photos[0]}>
  <PageHero title={album.title} eyebrow={`Fotoalbum · ${album.photos.length} foto’s`} image={album.photos[0]} crumbs={[{ label: 'Media', href: '/media/' }, { label: album.title }]} />
  <section class="section">
    <div class="container">
      <ul class="fotos" data-fotos>
        {album.photos.map((p, i) => (
          <li>
            <a href={p} data-index={i}>
              <img src={p.replace('.webp', '-thumb.webp')} alt={`${album.title} – foto ${i + 1}`} loading="lazy" width="480" height="320" />
            </a>
          </li>
        ))}
      </ul>
      {album.count > album.photos.length && <p class="small muted" style="margin-top:1rem">Selectie van {album.photos.length} uit {album.count} foto’s van het oorspronkelijke album.</p>}
      <nav class="buren" aria-label="Andere albums">
        {nieuwer ? <a href={`/media/${nieuwer.slug}/`} class="btn btn-ghost btn-sm">← {nieuwer.title}</a> : <span />}
        <a href="/media/" class="link-arrow">Alle albums</a>
        {ouder ? <a href={`/media/${ouder.slug}/`} class="btn btn-ghost btn-sm">{ouder.title} →</a> : <span />}
      </nav>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Foto bekijken">
    <img alt="" data-lb-img />
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Sluiten">✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Vorige foto">‹</button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Volgende foto">›</button>
    <p class="lb-teller" data-lb-teller></p>
  </dialog>
</Base>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-fotos] a'));
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const teller = dlg.querySelector<HTMLElement>('[data-lb-teller]')!;
  let i = 0;
  const toon = (n: number) => {
    i = (n + links.length) % links.length;
    img.src = links[i].href;
    img.alt = links[i].querySelector('img')?.alt ?? '';
    teller.textContent = `${i + 1} / ${links.length}`;
  };
  links.forEach((a, n) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      toon(n);
      dlg.showModal();
    }),
  );
  dlg.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lb-prev]')?.addEventListener('click', () => toon(i - 1));
  dlg.querySelector('[data-lb-next]')?.addEventListener('click', () => toon(i + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.addEventListener('keydown', (e) => {
    if (!dlg.open) return;
    if (e.key === 'ArrowLeft') toon(i - 1);
    if (e.key === 'ArrowRight') toon(i + 1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) toon(dx < 0 ? i + 1 : i - 1);
  });
</script>
<style>
  .fotos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .fotos a {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--sea-100);
  }
  .fotos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .fotos a:hover img {
    transform: scale(1.04);
  }
  .buren {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  .buren .btn {
    white-space: normal;
  }
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(5 10 28 / 0.94);
  }
  .lightbox::backdrop {
    background: rgb(5 10 28 / 0.6);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 86vh;
    object-fit: contain;
    border-radius: 6px;
  }
  .lb-btn {
    position: absolute;
    border: 0;
    background: rgb(255 255 255 / 0.12);
    color: var(--white);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .lb-btn:hover {
    background: var(--yellow-400);
    color: var(--navy-950);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
    font-size: 1.3rem;
  }
  .lb-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-teller {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: #c9d2ea;
    margin: 0;
    font-size: 0.9rem;
  }
</style>
