---
interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  image?: string;
  crumbs?: Crumb[];
}
const { title, eyebrow, lead, image = '/media/site/hero-3.webp', crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <img class="page-hero-img" src={image} alt="" width="1600" height="900" fetchpriority="high" />
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <a href="/">Home</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true">/</span>
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
