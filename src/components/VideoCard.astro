---
import Icon from './Icon.astro';
interface Props { platform: string; id: string; titel: string; thumbnail?: string | null }
const { platform, id, titel, thumbnail } = Astro.props;
const embed = platform === 'vimeo'
  ? `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1&byline=0&portrait=0`
  : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
const extern = platform === 'vimeo' ? `https://vimeo.com/${id}` : `https://www.youtube.com/watch?v=${id}`;
---
<figure class="video">
  <div class="embed" data-embed={embed}>
    <button type="button" class="play" aria-label={`Video afspelen: ${titel}`}>
      {thumbnail && <img src={thumbnail} alt="" loading="lazy" width="640" height="360" />}
      <span class="play-icon"><Icon name="play" size={30} /></span>
    </button>
  </div>
  <figcaption>
    <strong>{titel}</strong>
    <a href={extern} rel="noopener" target="_blank" class="small">Bekijk op {platform === 'vimeo' ? 'Vimeo' : 'YouTube'}</a>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = el.dataset.embed!;
      f.allow = 'autoplay; fullscreen; picture-in-picture';
      f.allowFullscreen = true;
      f.title = el.closest('figure')?.querySelector('strong')?.textContent ?? 'Video';
      el.replaceChildren(f);
    });
  });
</script>
<style>
  .video {
    margin: 0;
  }
  .play {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: var(--navy-900);
  }
  .play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .play:hover img {
    opacity: 1;
  }
  .play-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--yellow-400);
    color: var(--navy-950);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease;
  }
  .play:hover .play-icon {
    transform: translate(-50%, -50%) scale(1.08);
  }
  figcaption {
    display: grid;
    gap: 0.1rem;
    padding-top: 0.6rem;
  }
</style>
